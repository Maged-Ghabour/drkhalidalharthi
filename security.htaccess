# ============================================================
# ملف .htaccess للحماية الأمنية + الأداء - public_html
# ⚠️ دمج هذا مع ملف .htaccess الموجود
# ============================================================

# ============================================================
# ===== 🚀 PERFORMANCE SECTION =====
# ============================================================

# --- GZIP Compression (يقلل حجم الملفات حتى 70%) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# --- Browser Caching (يخزن الملفات محلياً عند المستخدم) ---
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML - لا تخزين (دائماً محدّث)
    ExpiresByType text/html                         "access plus 0 seconds"

    # CSS & JavaScript - سنة كاملة
    ExpiresByType text/css                          "access plus 1 year"
    ExpiresByType application/javascript            "access plus 1 year"
    ExpiresByType text/javascript                   "access plus 1 year"

    # صور - سنة كاملة
    ExpiresByType image/jpg                         "access plus 1 year"
    ExpiresByType image/jpeg                        "access plus 1 year"
    ExpiresByType image/gif                         "access plus 1 year"
    ExpiresByType image/png                         "access plus 1 year"
    ExpiresByType image/webp                        "access plus 1 year"
    ExpiresByType image/avif                        "access plus 1 year"
    ExpiresByType image/svg+xml                     "access plus 1 year"
    ExpiresByType image/x-icon                      "access plus 1 year"
    ExpiresByType image/ico                         "access plus 1 year"

    # خطوط - سنة كاملة
    ExpiresByType font/ttf                          "access plus 1 year"
    ExpiresByType font/otf                          "access plus 1 year"
    ExpiresByType font/woff                         "access plus 1 year"
    ExpiresByType font/woff2                        "access plus 1 year"
    ExpiresByType application/font-woff             "access plus 1 year"
    ExpiresByType application/font-woff2            "access plus 1 year"

    # Favicon
    ExpiresByType image/vnd.microsoft.icon          "access plus 1 month"
</IfModule>

# --- Cache-Control Headers ---
<IfModule mod_headers.c>
    # CSS & JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images & Fonts
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML - no-cache
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Keep-Alive لتقليل عدد الاتصالات
    Header set Connection keep-alive
</IfModule>

# --- ETag لتحسين التحقق من الكاش ---
FileETag MTime Size

# ============================================================
# ===== 🔒 SECURITY SECTION =====
# ============================================================

# --- منع تشغيل PHP داخل مجلد uploads ---
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^wp-content/uploads/.*\.php$ - [F,L]
</IfModule>

# --- منع الوصول المباشر لملفات حساسة ---
<FilesMatch "^(wp-config\.php|php\.ini|\.htpasswd|readme\.html|license\.txt)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# --- منع تصفح مجلدات الموقع (Directory Listing) ---
Options -Indexes

# --- حظر الـ xmlrpc.php ---
<Files xmlrpc.php>
    Order Deny,Allow
    Deny from all
</Files>

# --- Security Headers ---
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- منع قراءة ملف wp-config.php ---
<files wp-config.php>
    Order allow,deny
    Deny from all
</files>

# --- إخفاء معلومات الخادم ---
ServerSignature Off

# --- حظر بوتات الاختراق الشائعة ---
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} (havij|acunetix|nikto|sqlmap|nessus|openvas|nmap) [NC]
RewriteRule .* - [F,L]
</IfModule>

# --- حظر محاولات SQL Injection من URL ---
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{QUERY_STRING} (union.*select|insert.*into|drop.*table|select.*from|exec\(|eval\() [NC]
RewriteRule .* - [F,L]
</IfModule>
